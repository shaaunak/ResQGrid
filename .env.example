# ==============================================================================
# RESQGRID ENVIRONMENT CONFIGURATION (TEMPLATE)
# Cloud-Native Disaster Response & Intelligent Resource Coordination Platform
# ==============================================================================
# NOTE: DO NOT commit real secrets or credentials into version control.
# Copy this file to .env for local testing or populate via AWS SSM Parameter Store in production.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=ResQGrid
API_PORT=8000
WEB_PORT=5173
WORKER_PORT=8001

# CORS & Host settings
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGEME_IN_PRODUCTION_generate_random_secret_32_bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (PostgreSQL / SQLite fallback for tests)
# For local Docker: postgresql+asyncpg://resqgrid_app:resqgrid_secure_pass@localhost:5432/resqgrid_db
# For AWS RDS: postgresql+asyncpg://<app_user>:<app_pass>@<rds_endpoint>:5432/resqgrid_db
DATABASE_URL=sqlite+aiosqlite:///./resqgrid.db
DATABASE_SYNC_URL=sqlite:///./resqgrid.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# AWS Cloud Integration (Managed via IAM Roles on EC2 in production)
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# S3 Configuration
S3_BUCKET_NAME=resqgrid-evidence-ap-south-1-prod
S3_PRESIGNED_URL_EXPIRATION_SECONDS=900
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads

# SQS Configuration
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/resqgrid-incident-events
SQS_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/resqgrid-incident-events-dlq
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
QUEUE_BACKEND=outbox

# SNS Configuration
SNS_INCIDENT_ESCALATION_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:resqgrid-incident-escalations
SNS_RESOURCE_SHORTAGE_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:resqgrid-resource-shortages
NOTIFICATION_BACKEND=database

# CloudWatch Configuration
CLOUDWATCH_NAMESPACE=ResQGrid/Operations
CLOUDWATCH_METRICS_ENABLED=false

# Simulation Settings
DEFAULT_SIMULATION_REGION=Mumbai
DEFAULT_SIMULATION_LAT=19.0760
DEFAULT_SIMULATION_LON=72.8777

